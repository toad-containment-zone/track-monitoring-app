<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Track Survey Time-to-Detection</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="track_ttd_survey">
          <date/>
          <start_time/>
          <location_lat/>
          <location_lon/>
          <survey_track/>
          <survey_track_seconds/>
          <observer_names/>
          <duration_seconds/>
          <people_searching/>
          <recent_rain/>
          <substrate>red</substrate>
          <notes/>
          <detection jr:template="">
            <species/>
            <species_other/>
            <ttd_seconds/>
            <detection_lat/>
            <detection_lon/>
          </detection>
          <detection>
            <species/>
            <species_other/>
            <ttd_seconds/>
            <detection_lat/>
            <detection_lon/>
          </detection>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="yes_no_choices">
        <root>
          <item>
            <name>Yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>No</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="substrate_choices">
        <root>
          <item>
            <name>red</name>
            <label>Red</label>
          </item>
          <item>
            <name>grey</name>
