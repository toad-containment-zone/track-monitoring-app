      </instance>
      <bind nodeset="/data/date" type="date" required="true()"/>
      <bind nodeset="/data/start_time" type="time" required="true()"/>
      <bind nodeset="/data/location_lat" type="decimal" required="false()"/>
      <bind nodeset="/data/location_lon" type="decimal" required="false()"/>
      <bind nodeset="/data/survey_track" type="geotrace" required="false()"/>
      <bind nodeset="/data/survey_track_seconds" type="string" required="false()"/>
      <bind nodeset="/data/observer_names" type="string" required="false()"/>
      <bind nodeset="/data/duration_seconds" type="int" required="true()" constraint=". &gt;= 0"/>
      <bind nodeset="/data/people_searching" type="decimal" required="true()" constraint=". &gt; 0" jr:constraintMsg="Must be more than 0"/>
      <bind nodeset="/data/recent_rain" type="string" required="true()"/>
      <bind nodeset="/data/substrate" type="string" required="true()"/>
      <bind nodeset="/data/notes" type="string" required="false()"/>
      <bind nodeset="/data/detection/species" type="string" required="true()"/>
      <bind nodeset="/data/detection/species_other" type="string" required="true()" relevant=" ../species  = 'other_lizard' or  ../species  = 'other_mammal' or  ../species  = 'other'"/>
      <bind nodeset="/data/detection/ttd_seconds" type="int" required="true()" constraint=". &gt;= 0"/>
      <bind nodeset="/data/detection/detection_lat" type="decimal" required="false()"/>
      <bind nodeset="/data/detection/detection_lon" type="decimal" required="false()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/date">
      <label>Date</label>
    </input>
    <input ref="/data/start_time">
      <label>Survey start time</label>
    </input>
    <input ref="/data/location_lat">
      <label>Latitude</label>
      <hint>GPS latitude, captured when the survey is started</hint>
    </input>
    <input ref="/data/location_lon">
      <label>Longitude</label>
      <hint>GPS longitude, captured when the survey is started</hint>
    </input>
    <input ref="/data/survey_track">
      <label>Survey track</label>
      <hint>Auto-recorded GPS track of the walk</hint>
    </input>
    <input ref="/data/survey_track_seconds">
      <label>Survey track point times (elapsed seconds)</label>
    </input>
    <input ref="/data/observer_names">
      <label>Observer names</label>
    </input>
    <input ref="/data/duration_seconds">
      <label>Survey duration (seconds)</label>
      <hint>Total walk time from start to end of survey</hint>
    </input>
    <input ref="/data/people_searching">
      <label>Number of people searching</label>
      <hint>Can be fractional, e.g. 1.5 if someone joined partway</hint>
    </input>
    <select1 ref="/data/recent_rain">
      <label>Recent rain?</label>
      <itemset nodeset="instance('yes_no_choices')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <select1 ref="/data/substrate">
      <label>Substrate</label>
      <itemset nodeset="instance('substrate_choices')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <input ref="/data/notes">
      <label>Notes</label>
    </input>
    <group ref="/data/detection">
      <label>Species detection</label>
      <repeat nodeset="/data/detection">
        <select1 ref="/data/detection/species">
          <label>Species</label>
          <itemset nodeset="instance('species_choices')/root/item">
            <value ref="name"/>
            <label ref="label"/>
          </itemset>
        </select1>
        <input ref="/data/detection/species_other">
          <label>Please describe</label>
        </input>
        <input ref="/data/detection/ttd_seconds">
          <label>Time to detection (seconds)</label>
          <hint>Seconds from survey start to first sign of this species</hint>
        </input>
        <input ref="/data/detection/detection_lat">
          <label>Detection latitude</label>
        </input>
        <input ref="/data/detection/detection_lon">
          <label>Detection longitude</label>
        </input>
      </repeat>
    </group>
  </h:body>
</h:html>
